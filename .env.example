# Server-only settings. Never prefix secrets with VITE_.
RESEND_API_KEY=
APPLICATION_FROM_EMAIL=
# Set to "log" for local development: applications are logged to the server
# console instead of emailed, and Turnstile testing keys are accepted.
APPLICATION_DELIVERY=
TURNSTILE_SECRET_KEY=
# Public Turnstile site key; served through the readiness endpoint.
TURNSTILE_SITE_KEY=
# Exact origins separated by commas, no trailing slash.
APPLICATION_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
